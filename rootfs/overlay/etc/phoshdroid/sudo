#!/usr/bin/env python3
"""sudo for the Omdroid guest: a client for the fake-root broker.

The desktop session runs under proot as uid 1000, so nothing in it can become
root and the image has no sudo package (setuid would not work under proot
anyway). ProotService starts a second proot of the same rootfs with `-0`
(fake root) running /etc/phoshdroid/omdroid-rootd.py; this client sends it the
command, the cwd, a small environment and either the caller's terminal or
plain pipes, and relays the result. The transport lives in omdroid_root.py,
which the fakeroot shim imports too.

There is no password: the whole guest is the app's own uid inside its private
storage, so fake root grants no real privilege. It exists so the 70 Omarchy
scripts that call `sudo` (pacman, tee, sed, rm, cp, mkdir, env) work.

Supported: `sudo cmd...`, `--`, `-n`, `-E`, `-u USER`, `-i`, `-s`, `-v`, `-k`,
`-l`, `-h`, `-V`, and `VAR=value` before the command. Unknown flags are an
error, as in sudo.
"""
import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
if HERE not in sys.path:
    sys.path.insert(0, HERE)

import omdroid_root

VERSION = "omdroid sudo 1.0 (fake root through the omdroid root broker)"

USAGE = """usage: sudo [-n] [-E] [-u user] [-i | -s] [-v | -k | -l | -h | -V] [--] command [arg ...]

Omdroid's sudo: runs the command as fake root inside the guest. No password.
"""

# sudo's env_reset keeps a small list; the host adds the session's display and
# runtime variables so Omarchy's GUI-aware scripts keep working as root.
KEEP_ENV = (
    "PATH",
    "TERM",
    "LANG",
    "LANGUAGE",
    "LC_ALL",
    "LC_CTYPE",
    "LC_MESSAGES",
    "WAYLAND_DISPLAY",
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "XDG_SESSION_TYPE",
    "XDG_CURRENT_DESKTOP",
    "EDITOR",
    "VISUAL",
    "PAGER",
)


class Options:
    def __init__(self):
        self.user = os.environ.get("OMDROID_ROOTD_DEFAULT_USER") or "root"
        self.noninteractive = False
        self.keep_env = False
        self.login = False
        self.shell = False
        self.validate = False
        self.reset = False
        self.list = False
        self.help = False
        self.version = False
        self.rest = []


def usage_error(message):
    sys.stderr.write("sudo: %s\n%s" % (message, USAGE))
    raise SystemExit(1)


def parse(argv):
    options = Options()
    index = 0
    while index < len(argv):
        arg = argv[index]
        if arg == "--":
            options.rest = argv[index + 1 :]
            return options
        if arg.startswith("--"):
            name, _, value = arg.partition("=")
            if name == "--user":
                if not value:
                    index += 1
                    if index >= len(argv):
                        usage_error("option '--user' requires an argument")
                    value = argv[index]
                options.user = value
            elif name == "--login":
                options.login = True
            elif name == "--shell":
                options.shell = True
            elif name in ("--non-interactive",):
                options.noninteractive = True
            elif name in ("--preserve-env",):
                options.keep_env = True
            elif name in ("--list",):
                options.list = True
            elif name in ("--validate",):
                options.validate = True
            elif name in ("--remove-timestamp", "--reset-timestamp"):
                options.reset = True
            elif name in ("--version",):
                options.version = True
            elif name in ("--help",):
                options.help = True
            else:
                usage_error("unrecognized option '%s'" % name)
            index += 1
            continue
        if arg.startswith("-") and arg != "-":
            position = 1
            while position < len(arg):
                flag = arg[position]
                if flag == "u":
                    value = arg[position + 1 :]
                    if not value:
                        index += 1
                        if index >= len(argv):
                            usage_error("option requires an argument -- 'u'")
                        value = argv[index]
                    options.user = value
                    position = len(arg)
                    break
                if flag == "n":
                    options.noninteractive = True
                elif flag == "E":
                    options.keep_env = True
                elif flag == "i":
                    options.login = True
                elif flag == "s":
                    options.shell = True
                elif flag == "v":
                    options.validate = True
                elif flag == "k" or flag == "K":
                    options.reset = True
                elif flag == "l":
                    options.list = True
                elif flag == "h":
                    options.help = True
                elif flag == "V":
                    options.version = True
                else:
                    usage_error("invalid option -- '%s'" % flag)
                position += 1
            index += 1
            continue
        options.rest = argv[index:]
        return options
    return options


def build_request(options, argv, extra_env):
    env = {}
    if options.keep_env:
        env.update({k: v for k, v in os.environ.items() if isinstance(v, str)})
    for key in KEEP_ENV:
        if key in os.environ:
            env[key] = os.environ[key]
    env["SUDO_USER"] = os.environ.get("USER") or os.environ.get("LOGNAME") or "omarchy"
    env["SUDO_UID"] = str(os.getuid())
    env["SUDO_GID"] = str(os.getgid())
    env["SUDO_COMMAND"] = " ".join(argv)

    cwd = None if options.login else os.getcwd()
    return {
        "argv": argv,
        "cwd": cwd,
        "env": env,
        "env_extra": dict(extra_env),
        "user": options.user,
        "tty": omdroid_root.tty_spec(),
        "keep_env": options.keep_env,
    }


def main(argv):
    options = parse(argv)
    if options.version:
        print(VERSION)
        return 0
    if options.help:
        sys.stdout.write(USAGE)
        return 0
    if options.validate:
        # sudo -v refreshes its timestamp and does not run a command.
        return 0
    if options.reset and not options.rest and not (options.login or options.shell):
        # sudo -k alone invalidates the cached timestamp. With a command it
        # must run that command (sudo -k pacman -U ...): makepkg installs its
        # packages exactly that way.
        return 0
    if options.list:
        user = os.environ.get("USER") or "omarchy"
        print("User %s may run the following commands on omdroid:" % user)
        print("    (ALL : ALL) NOPASSWD: ALL")
        return 0

    extra_env = {}
    rest = list(options.rest)
    while rest:
        head = rest[0]
        name, sep, value = head.partition("=")
        if sep and name and name.replace("_", "a").isalnum() and not name[0].isdigit():
            extra_env[name] = value
            rest.pop(0)
            continue
        break

    if not rest and not (options.login or options.shell):
        sys.stderr.write(USAGE)
        return 1

    if options.login:
        command = rest or ["/bin/bash", "-l"]
    elif options.shell:
        command = rest or [os.environ.get("SHELL") or "/bin/bash"]
    else:
        command = rest

    return omdroid_root.relay(build_request(options, command, extra_env), "sudo")


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except BrokenPipeError:
        sys.exit(1)
