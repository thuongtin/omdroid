#!/bin/bash
# Logout = end the desktop session (launch contract, section 10).
# Omarchy's own omarchy-system-logout needs systemd and uwsm, which this guest does not have, so it
# fails without a word. Linked over /usr/local/bin/omarchy-system-logout by complete/session-start.sh
# (OMDROID_COMPLETE_POWER=0 puts the original link back).
exec "$(dirname "$(readlink -f "$0")")/omdroid-session" stop
