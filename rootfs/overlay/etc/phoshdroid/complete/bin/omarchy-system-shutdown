#!/bin/bash
# Shutdown = end the session and close the app, not the tablet.
# Omarchy's own omarchy-system-shutdown needs systemd and uwsm, which this guest does not have, so it
# fails without a word. Linked over /usr/local/bin/omarchy-system-shutdown by complete/session-start.sh
# (OMDROID_COMPLETE_POWER=0 puts the original link back).
exec "$(dirname "$(readlink -f "$0")")/omdroid-session" shutdown
